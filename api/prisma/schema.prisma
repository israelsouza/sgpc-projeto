generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TipoCondominio {
  PREDIO
  HORIZONTAL
}

model Condominio {
  id       Int            @id @default(autoincrement())
  nome     String         @map("nome")
  tipoCond TipoCondominio @default(PREDIO)
  cnpj     String?        @unique @map("cnpj")
  endereco String?        @map("endereco")

  // Auditoria e Soft Delete
  criado_em     DateTime  @default(now()) @map("criado_em")
  atualizado_em DateTime  @updatedAt @map("atualizado_em")
  deletado_em   DateTime? @map("deletado_em")
  quem_criou    Int?      @map("quem_criou")

  // Relacionamentos
  unidades      Unidade[]
  funcionarios  Funcionario[]
  chaves_acesso ChaveAcesso[]
  avisos        Aviso[]
  documentos    Documento[]

  @@map("CONDOMINIOS")
}

model Unidade {
  id      Int     @id @default(autoincrement())
  unidade String  @unique @map("unidade")
  bloco   String? @map("bloco")
  andar   Int?    @map("andar")

  // FKs
  condominio_id Int @map("condominio_id")

  // Auditoria e Soft Delete
  criado_em     DateTime  @default(now()) @map("criado_em")
  atualizado_em DateTime  @updatedAt @map("atualizado_em")
  deletado_em   DateTime? @map("deletado_em")
  quem_criou    Int?      @map("quem_criou")

  // Relacionamentos
  condominio    Condominio     @relation(fields: [condominio_id], references: [id])
  moradores     Morador[]
  chaves_acesso ChaveAcesso[]
  manifestacoes Manifestacao[]

  @@map("UNIDADES")
}

model Perfil {
  id   Int    @id @default(autoincrement())
  nome String @unique @map("nome")

  // Relacionamentos
  usuarios      Usuario[]
  chaves_acesso ChaveAcesso[]
  permissoes    Permissao[]

  @@map("PERFIS")
}

model Permissao {
  id        Int     @id @default(autoincrement())
  nome      String  @unique @map("nome")
  descricao String? @map("descricao")

  // Relacionamentos
  perfis Perfil[]

  @@map("PERMISSOES")
}

model Usuario {
  id     Int    @id @default(autoincrement())
  email  String @unique @map("email")
  senha  String @map("senha")
  status String @default("ATIVO") @map("status")

  // Auditoria e Soft Delete
  criado_em     DateTime  @default(now()) @map("criado_em")
  atualizado_em DateTime  @updatedAt @map("atualizado_em")
  deletado_em   DateTime? @map("deletado_em")

  // Relacionamentos
  perfis             Perfil[]
  morador            Morador?
  funcionario        Funcionario?
  recuperacoes_senha RecuperacaoSenha[]
  fcm_tokens         FCMToken[]
  documentos_criados Documento[]
  documentos_logs    DocumentoLog[]

  @@map("USUARIOS")
}

enum CategoriaAviso {
  MANUTENCAO
  ASSEMBLEIA
  URGENTE
  GERAL
}

model Aviso {
  id        Int            @id @default(autoincrement())
  titulo    String         @map("titulo")
  descricao String         @map("descricao")
  categoria CategoriaAviso @map("categoria")
  anexo_url String?        @map("anexo_url")

  // FKs
  condominio_id Int @map("condominio_id")

  // Auditoria e Soft Delete
  criado_em     DateTime  @default(now()) @map("criado_em")
  atualizado_em DateTime  @updatedAt @map("atualizado_em")
  deletado_em   DateTime? @map("deletado_em")
  quem_criou    Int?      @map("quem_criou")

  // Relacionamentos
  condominio Condominio @relation(fields: [condominio_id], references: [id])

  @@map("AVISOS")
}

model Documento {
  id        Int     @id @default(autoincrement())
  titulo    String  @db.VarChar(255)
  descricao String?
  categoria String  @db.VarChar(100) // Ex: "Financeiro", "Ata", "Regulamento"

  file_id       String  @unique // ID retornado pelo Cloudinary (mantido para compatibilidade)
  filename_orig String // Nome original do arquivo (DEVE ser sanitizado antes de salvar)
  sha256_hash   String // Hash criptográfico para validação de integridade do arquivo
  conteudo      Bytes? // CONTEUDO BINARIO DO ARQUIVO (Backup/Local)

  condominio_id Int
  condominio    Condominio @relation(fields: [condominio_id], references: [id])

  quem_criou_id Int
  quem_criou    Usuario @relation(fields: [quem_criou_id], references: [id])

  criado_em     DateTime  @default(now())
  atualizado_em DateTime  @updatedAt
  deletado_em   DateTime?

  @@map("documentos")
}

model DocumentoLog {
  id           Int      @id @default(autoincrement())
  documento_id Int
  usuario_id   Int
  acao         String   @db.VarChar(50) // Ex: "DOWNLOAD", "UPLOAD", "DELETE"
  ip_address   String?  @db.VarChar(45)
  criado_em    DateTime @default(now())

  usuario Usuario @relation(fields: [usuario_id], references: [id])

  @@map("documentos_logs")
}

model FCMToken {
  id          Int      @id @default(autoincrement())
  token       String   @unique @map("token")
  usuario_id  Int      @map("usuario_id")
  dispositivo String?  @map("dispositivo")
  criado_em   DateTime @default(now()) @map("criado_em")

  // Relacionamentos
  usuario Usuario @relation(fields: [usuario_id], references: [id])

  @@map("FCM_TOKENS")
}

model RecuperacaoSenha {
  id         Int      @id @default(autoincrement())
  usuario_id Int      @map("usuario_id")
  codigo     String   @map("codigo")
  expira_em  DateTime @map("expira_em")
  usada      Boolean  @default(false) @map("usada")
  criado_em  DateTime @default(now()) @map("criado_em")

  usuario Usuario @relation(fields: [usuario_id], references: [id])

  @@map("RECUPERACOES_SENHA")
}

model Convite {
  id             Int      @id @default(autoincrement())
  token          String   @unique @map("token")
  morador_id     Int      @map("morador_id")
  tipo           String   @default("VISITANTE") @map("tipo") // VISITANTE, PRESTADOR_SERVICO
  data_expiracao DateTime @map("data_expiracao")
  status         String   @default("PENDENTE") @map("status") // PENDENTE, UTILIZADO, EXPIRADO

  // Relacionamentos
  morador Morador @relation(fields: [morador_id], references: [id])

  // Auditoria
  criado_em DateTime @default(now()) @map("criado_em")

  @@map("CONVITES")
}

model Visitante {
  id            Int    @id @default(autoincrement())
  nome_completo String @map("nome_completo")
  documento     String @map("documento")
  celular       String @map("celular")
  tipo          String @default("VISITANTE") @map("tipo") // VISITANTE, PRESTADOR_SERVICO
  morador_id    Int    @map("morador_id")

  // Relacionamentos
  morador Morador @relation("MoradorVisitantes", fields: [morador_id], references: [id])

  // Auditoria
  criado_em DateTime @default(now()) @map("criado_em")

  @@map("VISITANTES")
}

model Morador {
  id              Int     @id @default(autoincrement())
  nome_completo   String  @map("nome_completo")
  celular         String  @unique @map("celular")
  rg              String? @map("rg")
  cpf             String  @unique @map("cpf")
  data_nascimento String  @map("data_nascimento")
  status          String  @default("PENDENTE") @map("status")

  // Auditoria e Soft Delete
  criado_em     DateTime  @default(now()) @map("criado_em")
  atualizado_em DateTime  @updatedAt @map("atualizado_em")
  deletado_em   DateTime? @map("deletado_em")
  quem_criou    Int?      @map("quem_criou")

  // FKs
  usuario_id Int? @unique @map("usuario_id")
  unidade_id Int? @map("unidade_id")

  // Relacionamentos

  usuario    Usuario?    @relation(fields: [usuario_id], references: [id])
  unidade    Unidade?    @relation(fields: [unidade_id], references: [id])
  convites   Convite[]
  visitantes Visitante[] @relation("MoradorVisitantes")
  entregas   Entrega[]
  bilhetes      Bilhetes[]
  manifestacoes Manifestacao[]

  @@map("MORADORES")
}

model Funcionario {
  id              Int    @id @default(autoincrement())
  nome_completo   String @map("nome_completo")
  celular         String @unique @map("celular")
  rg              String @map("rg")
  cpf             String @unique @map("cpf")
  data_nascimento String @map("data_nascimento")
  cargo           String @map("cargo") // SINDICO, PORTEIRO, ZELADOR, etc.
  status          String @default("ATIVO") @map("status")

  // Auditoria e Soft Delete
  criado_em     DateTime  @default(now()) @map("criado_em")
  atualizado_em DateTime  @updatedAt @map("atualizado_em")
  deletado_em   DateTime? @map("deletado_em")
  quem_criou    Int?      @map("quem_criou")

  // FKs
  usuario_id    Int @unique @map("usuario_id")
  condominio_id Int @map("condominio_id")

  // Relacionamentos
  usuario    Usuario    @relation(fields: [usuario_id], references: [id])
  condominio Condominio @relation(fields: [condominio_id], references: [id])

  @@map("FUNCIONARIOS")
}

model ChaveAcesso {
  id       String   @id @default(uuid()) @map("id")
  chave    String   @unique @default(uuid()) @map("chave")
  validade DateTime @map("validade")
  usada    Boolean  @default(false) @map("usada")

  // DNA da Chave
  perfil_id     Int  @map("perfil_id")
  condominio_id Int  @map("condominio_id")
  unidade_id    Int? @map("unidade_id")

  // Relacionamentos
  perfil     Perfil     @relation(fields: [perfil_id], references: [id])
  condominio Condominio @relation(fields: [condominio_id], references: [id])
  unidade    Unidade?   @relation(fields: [unidade_id], references: [id])

  // Auditoria
  criado_em     DateTime @default(now()) @map("criado_em")
  atualizado_em DateTime @updatedAt @map("atualizado_em")
  quem_criou    Int?     @map("quem_criou")

  @@map("CHAVES_ACESSO")
}

enum StatusEntrega {
  AGUARDANDO
  RECEBIDA
  RETIRADA
  CANCELADA
}

enum CategoriaEntrega {
  CARTA
  PACOTE
}

model Entrega {
  id                         Int              @id @default(autoincrement())
  morador_id                 Int              @map("morador_id")
  tipo                       CategoriaEntrega @map("tipo")
  status                     StatusEntrega    @default(AGUARDANDO) @map("status")
  prazo_retirada             DateTime         @map("prazo_retirada")
  mensagem                   String?          @map("mensagem")
  observacao_porteiro        String?          @map("observacao_porteiro")
  justificativa_cancelamento String?          @map("justificativa_cancelamento")

  criado_em     DateTime  @default(now()) @map("criado_em")
  atualizado_em DateTime  @updatedAt @map("atualizado_em")
  deletado_em   DateTime? @map("deletado_em")
  quem_criou    Int?      @map("quem_criou")
  quem_recebeu  Int?      @map("quem_recebeu")

  morador Morador @relation(fields: [morador_id], references: [id])

  @@map("ENTREGAS")
}

model Bilhetes {
  id           Int      @id @default(autoincrement())
  assunto      String   @db.VarChar(120)
  mensagem     String   @db.VarChar(320)
  categoria    String   @default("bilhete")
  autor        String
  data_criacao DateTime @default(now())
  hora_criacao String

  // Informações da unidade
  unidade String?
  bloco   String?
  andar   Int?

  // Horizontal
  numero  String?
  prefixo String?

  // Relacionamentos
  morador_id Int?
  morador    Morador? @relation(fields: [morador_id], references: [id])

  // Auditoria
  criado_em   DateTime  @default(now()) @map("criado_em")
  deletado_em DateTime? @map("deletado_em")

  @@map("BILHETES")
}

enum StatusManifestacao {
  PENDENTE
  EM_ANDAMENTO
  AGUARDANDO
  CONCLUIDO
  ENCERRADO
}

model Manifestacao {
  id           Int                @id @default(autoincrement())
  assunto      String             @db.VarChar(120)
  mensagem     String             @db.VarChar(320)
  categoria    String             @default("solicitacao")
  status       StatusManifestacao @default(PENDENTE)
  autor        String
  data_criacao DateTime           @default(now())
  hora_criacao String

  //DADOS DAS UNIDADES
  unidade String?
  bloco   String?
  andar   Int?

  //HORIZONTAL
  numero  String?
  prefixo String?

  TipoCondominio TipoCondominio?

  //FK
  morador_id Int?
  unidade_id Int?

  morador     Morador? @relation(fields: [morador_id], references: [id])
  unidade_rel Unidade? @relation(fields: [unidade_id], references: [id])

  movimentacoes ManifestacaoMovimentacao[]

  // Auditoria
  criado_em     DateTime  @default(now())
  atualizado_em DateTime  @updatedAt
  deletado_em   DateTime?

  @@map("MANIFESTACOES")
}

model ManifestacaoMovimentacao {
  id Int @id @default(autoincrement())

  titulo     String
  comentario String?

  status StatusManifestacao

  autor_role String?

  data_movimentacao DateTime @default(now())

  // FK
  manifestacao_id Int

  manifestacao Manifestacao @relation(fields: [manifestacao_id], references: [id])

  @@map("MANIFESTACAO_MOVIMENTACOES")
}

model Espaco {
  id        Int        @id @default(autoincrement())
  nome      String
  icone     String
  cor       String

  reservas  Reserva[]
}

model Reserva {
  id             Int       @id @default(autoincrement())
  data_reserva   DateTime

  usuario_id     Int
  espaco_id      Int

  espaco         Espaco    @relation(fields: [espaco_id], references: [id])
}
